      "name": "순위·곡·가수·좋아요 병합",
      "parameters": {
        "jsCode": "const likes = {};\nfor (const it of $input.all()) {\n  for (const l of it.json.contsLike || []) likes[String(l.CONTSID)] = Number(l.SUMMCNT);\n}\nconst now = new Date().toLocaleString('sv-SE', { timeZone: 'Asia/Seoul' });\nreturn $('차트 파싱').all().map(s => ({ json: {\n  '순위': s.json.rank, '곡제목': s.json.title, '가수': s.json.artist,\n  '좋아요수': likes[s.json.songId] ?? '', '수집일시': now } }));"
      },
