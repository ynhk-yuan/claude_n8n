    {
      "id": "m3",
      "name": "차트 파싱",
      "parameters": {
        "jsCode": "const html = $input.first().json.data?.rawHtml || $input.first().json.rawHtml || '';\nconst named = { nbsp: ' ', amp: '&', lt: '<', gt: '>', quot: '\"', Eacute: 'É', eacute: 'é', Aacute: 'Á', aacute: 'á', Uuml: 'Ü', uuml: 'ü', Ouml: 'Ö', ouml: 'ö' };\nconst dec = s => s.replace(/&#0?39;/g, \"'\").replace(/&#(\\d+);/g, (m, n) => String.fromCharCode(+n)).replace(/&([A-Za-z]+);/g, (m, n) => named[n] ?? m).replace(/\\s+/g, ' ').trim();\nconst rows = html.split(/<tr[^>]*class=\"lst(?:50|100)\"/).slice(1);\nconst songs = rows.map(r => ({\n  rank: Number((r.match(/<span class=\"rank[^\"]*\">(\\d+)<\\/span>/) || [])[1]),\n  title: dec((r.match(/class=\"ellipsis rank01\">[\\s\\S]*?<a [^>]*>([\\s\\S]*?)<\\/a>/) || [])[1] || ''),\n  artist: dec((r.match(/class=\"ellipsis rank02\">\\s*<a [^>]*>([\\s\\S]*?)<\\/a>/) || [])[1] || ''),\n  songId: (r.match(/value=\"(\\d+)\"/) || [])[1],\n})).filter(s => s.songId);\nif (!songs.length) throw new Error('차트 데이터를 파싱하지 못했습니다. Firecrawl 응답을 확인하세요.');\nreturn songs.map(s => ({ json: s }));\n"
      },
      "position": [
        864,
        304
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
