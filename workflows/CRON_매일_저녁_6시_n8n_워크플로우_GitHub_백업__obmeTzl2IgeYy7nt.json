      "id": "g8",
      "name": "커밋 파일 구성",
      "parameters": {
        "jsCode": "const cfg = $('백업 설정').first().json;\nconst baseCommit = $('기준 커밋 조회').first().json;\nconst wfs = $('워크플로우 목록 조회').all().map((i) => i.json).filter((w) => w && w.id);\nif (wfs.length === 0) { throw new Error('워크플로우 목록이 비어 있습니다. n8n API 크리덴셜을 확인하세요.'); }\nconst slug = (s) => String(s || 'untitled').replace(/[^0-9A-Za-z가-힣_-]+/g, '_').replace(/^_+|_+$/g, '').slice(0, 80) || 'untitled';\nconst sortKeys = (v) => Array.isArray(v) ? v.map(sortKeys) : (v && typeof v === 'object' ? Object.keys(v).sort().reduce((o, k) => { o[k] = sortKeys(v[k]); return o; }, {}) : v);\nconst entries = wfs.map((w) => {\n  const clean = sortKeys({ id: w.id, name: w.name, active: w.active, isArchived: w.isArchived, nodes: w.nodes, connections: w.connections, settings: w.settings, pinData: w.pinData, tags: (w.tags || []).map((t) => t.name || t), versionId: w.versionId, updatedAt: w.updatedAt });\n  return { path: cfg.folder + '/' + slug(w.name) + '__' + w.id + '.json', mode: '100644', type: 'blob', content: JSON.stringify(clean, null, 2) + String.fromCharCode(10) };\n});\nconst keep = new Set(entries.map((e) => e.path));\nconst existing = $('기존 백업 목록').all().map((i) => i.json).filter((f) => f && f.type === 'file' && typeof f.path === 'string' && f.path.endsWith('.json'));\nconst removed = existing.filter((f) => !keep.has(f.path)).map((f) => ({ path: f.path, mode: '100644', type: 'blob', sha: null }));\nconst ts = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Seoul', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }).format(new Date());\nreturn [{ json: { owner: cfg.owner, repo: cfg.repo, branch: cfg.branch, parentSha: baseCommit.sha, baseTreeSha: baseCommit.tree.sha, workflowCount: entries.length, removedCount: removed.length, message: 'n8n 워크플로우 백업 ' + ts + ' KST (' + entries.length + '개' + (removed.length ? ', 삭제 ' + removed.length + '개' : '') + ')', tree: entries.concat(removed) } }];"
      },
