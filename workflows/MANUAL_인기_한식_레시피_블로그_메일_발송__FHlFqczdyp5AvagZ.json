    {
      "id": "n7",
      "name": "블로그 양식 정리",
      "parameters": {
        "jsCode": "const blogRaw = $('OpenAI 레시피 블로그 작성').first().json;\nlet b = blogRaw.message?.content ?? blogRaw.content ?? blogRaw;\nif (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) { b = {}; } }\nconst sel = $('선정 결과 정리').first().json;\nconst title = b.title || sel.title;\nconst description = b.description || sel.description;\n\nconst pages = Object.values($input.first().json.query?.pages || {});\nconst withImg = pages.filter(p => p.thumbnail?.source).sort((a, b) => (a.index || 0) - (b.index || 0));\nconst imageUrl = withImg[0]?.thumbnail?.source || '';\n\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst ing = (b.ingredients || []).map(i => `<li>${esc(i)}</li>`).join('');\nconst steps = (b.steps || []).map(s => `<li style=\"margin-bottom:6px\">${esc(s)}</li>`).join('');\n\nconst html = `<div style=\"max-width:640px;margin:0 auto;font-family:'Malgun Gothic',Arial,sans-serif;color:#222;line-height:1.7\">\n<h1 style=\"border-bottom:3px solid #d9480f;padding-bottom:8px\">${esc(title)}</h1>\n<p style=\"background:#fff4e6;padding:12px;border-radius:6px\"><b>음식 설명</b> : ${esc(description)}</p>\n${imageUrl ? `<p><img src=\"${imageUrl}\" alt=\"${esc(title)}\" style=\"width:100%;border-radius:8px\"></p>` : ''}\n<p>${esc(b.intro)}</p>\n<h2>🥘 재료</h2><ul>${ing}</ul>\n<h2>👩‍🍳 요리 순서</h2><ol>${steps}</ol>\n<h2>💡 요리 팁</h2><p>${esc(b.tip)}</p>\n<hr><p style=\"color:#666\">${esc(b.outro)}</p>\n</div>`;\n\nreturn [{ json: { title, description, imageUrl, html, subject: `[오늘의 한식] ${title} 만드는 방법` } }];"
      },
